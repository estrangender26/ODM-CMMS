<% title = template ? template.template_name : 'Template Detail' %>
<% showBack = true %>
<% showNav = true %>
<% activeNav = 'know' %>

<div style="padding: 0 0 80px;">
    <% if (!template) { %>
        <div class="card" style="text-align: center; padding: 48px 24px;">
            <div style="font-size: 48px; margin-bottom: 16px;">📚</div>
            <div style="font-size: 17px; font-weight: 600; margin-bottom: 8px;">Template not found</div>
            <div style="font-size: 14px; color: var(--text-secondary);">
                The requested task template could not be loaded.
            </div>
        </div>
    <% } else { %>
        <!-- Template Header -->
        <div class="card" style="margin-bottom: 16px;">
            <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
                <%= hierarchy %>
            </div>
            <h1 style="font-size: 22px; font-weight: 700; margin: 0 0 8px 0;"><%= template.template_name %></h1>
            <% if (template.template_code) { %>
                <div style="font-size: 13px; color: var(--text-secondary); margin-bottom: 8px;">
                    Code: <%= template.template_code %>
                </div>
            <% } %>
            <% if (template.description) { %>
                <div style="font-size: 14px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.5;">
                    <%= template.description %>
                </div>
            <% } %>
            <% if (template.maintenance_type || template.task_kind || template.estimated_duration_minutes) { %>
                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                    <% if (template.maintenance_type) { %>
                        <span style="font-size: 12px; background: var(--primary-subtle); color: var(--primary-dark); padding: 4px 10px; border-radius: 12px; font-weight: 500;">
                            <%= template.maintenance_type %>
                        </span>
                    <% } %>
                    <% if (template.task_kind) { %>
                        <span style="font-size: 12px; background: var(--bg-secondary); color: var(--text-secondary); padding: 4px 10px; border-radius: 12px; font-weight: 500;">
                            <%= template.task_kind %>
                        </span>
                    <% } %>
                    <% if (template.estimated_duration_minutes) { %>
                        <span style="font-size: 12px; background: var(--bg-secondary); color: var(--text-secondary); padding: 4px 10px; border-radius: 12px; font-weight: 500;">
                            <%= template.estimated_duration_minutes %> min
                        </span>
                    <% } %
                </div>
            <% } %>
        </div>

        <!-- Steps -->
        <% if (template.steps && template.steps.length > 0) { %>
            <div style="margin-bottom: 16px;">
                <div style="font-size: 14px; font-weight: 600; color: var(--text-secondary); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                    Procedure — <%= template.steps.length %> step<%= template.steps.length === 1 ? '' : 's' %>
                </div>

                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <% template.steps.forEach(function(step) { %>
                        <div class="card" style="padding: 16px;">
                            <div style="display: flex; align-items: flex-start; gap: 12px;">
                                <div style="width: 28px; height: 28px; border-radius: 50%; background: var(--primary-subtle); color: var(--primary-dark); display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; flex-shrink: 0;">
                                    <%= step.step_no %>
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <div style="font-weight: 500; font-size: 15px; line-height: 1.4;"><%= step.instruction %></div>
                                    
                                    <% if (step.data_type || step.unit || step.expected_value || step.min_value !== null || step.max_value !== null) { %>
                                        <div style="font-size: 13px; color: var(--text-secondary); margin-top: 6px;">
                                            <%= [step.data_type, step.unit, step.expected_value !== null ? 'Expected: ' + step.expected_value : null, step.min_value !== null ? 'Min: ' + step.min_value : null, step.max_value !== null ? 'Max: ' + step.max_value : null].filter(Boolean).join(' · ') %>
                                        </div>
                                    <% } %>

                                    <% if (step.is_required) { %>
                                        <div style="font-size: 12px; color: var(--danger); margin-top: 6px; font-weight: 500;">
                                            Required
                                        </div>
                                    <% } %>

                                    <% if (step.options) { %>
                                        <div style="font-size: 13px; color: var(--text-secondary); margin-top: 6px;">
                                            Options: <%= step.options %>
                                        </div>
                                    <% } %
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% } else { %>
            <div class="card" style="text-align: center; padding: 32px 24px; margin-bottom: 16px;">
                <div style="font-size: 24px; margin-bottom: 8px;">📋</div>
                <div style="font-size: 15px; color: var(--text-secondary);">No procedure steps recorded for this template.</div>
            </div>
        <% } %>

        <!-- Safety Controls -->
        <% if (template.safety_controls && template.safety_controls.length > 0) { %>
            <div style="margin-bottom: 16px;">
                <div style="font-size: 14px; font-weight: 600; color: var(--danger); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                    Safety Controls
                </div>

                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <% template.safety_controls.forEach(function(control) { %>
                        <div class="card" style="padding: 16px; border-left: 4px solid var(--danger);">
                            <div style="font-weight: 500; font-size: 15px; margin-bottom: 4px;"><%= control.control_name || 'Safety control' %></div>
                            <% if (control.description) { %>
                                <div style="font-size: 13px; color: var(--text-secondary);"><%= control.description %></div>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% } %>
    <% } %>
</div>
