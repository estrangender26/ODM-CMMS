<% const navRole = typeof userRole !== 'undefined' ? userRole : null; %>
<% const navIsAdmin = navRole === 'admin'; %>
<% const navIsSupervisor = navRole === 'supervisor'; %>
<% const navIsOperator = navRole === 'operator'; %>
<% const navCanInspect = navIsSupervisor || navIsOperator; %>
<% const navCanAssess = navIsAdmin || navIsSupervisor; %>
<% const navCanEscalate = navIsAdmin || navIsSupervisor; %>

<nav class="bottom-nav">
    <a href="/mobile/today" class="nav-item <%= activeNav === 'today' ? 'active' : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Today</span>
    </a>

    <% if (navCanInspect) { %>
    <a href="/mobile/inspection/adhoc" class="nav-item <%= activeNav === 'inspect' ? 'active' : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span>Inspect</span>
    </a>
    <% } %>

    <a href="/mobile/inspection/adhoc" class="nav-item <%= activeNav === 'report' ? 'active' : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
        <span>Report</span>
    </a>

    <a href="/mobile/templates" class="nav-item <%= activeNav === 'know' ? 'active' : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
        <span>Know</span>
    </a>

    <% if (navCanAssess) { %>
    <a href="/mobile/dashboard/findings" class="nav-item <%= activeNav === 'assess' ? 'active' : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Assess</span>
    </a>
    <% } %>

    <% if (navCanEscalate) { %>
    <a href="/mobile/dashboard/findings" class="nav-item <%= activeNav === 'escalate' ? 'active' : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
            <polyline points="16 7 22 7 22 13"/>
        </svg>
        <span>Escalate</span>
    </a>
    <% } %>
</nav>
