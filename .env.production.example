# Production configuration template. Store actual values in your hosting provider.
#
# Phase 3: PostgreSQL is the primary production runtime database. The API
# server connects through the `pg` driver. `mysql2` is retained only for
# documented legacy import/migration utilities and MUST NOT be loaded by
# the production HTTP runtime.
PORT=3000
HOST=0.0.0.0
# Set only for a known reverse-proxy topology: loopback or a trusted hop count.
TRUST_PROXY=
NODE_ENV=production

# PostgreSQL connection (set PG* or DB_*; PG* takes precedence when present).
DB_HOST=your-production-db-host
DB_PORT=5432
DB_NAME=odm_cmms
DB_USER=odm_cmms
DB_PASSWORD=replace-with-a-secret
DB_CONNECTION_LIMIT=10
# Enable TLS for managed PostgreSQL services. Set DB_SSL_REJECT_UNAUTHORIZED=false
# only when the provider presents a self-signed/non-verifiable certificate.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=uploads
# CSV imports are separately constrained by Multer file size and this row cap
ASSET_IMPORT_MAX_ROWS=10000
REQUEST_BODY_LIMIT=1mb
# Comma-separated trusted browser origins. Leave blank when the app is same-origin only.
CORS_ALLOWED_ORIGINS=https://app.example.com
LOG_LEVEL=info
