# Production configuration template. Store actual values in your hosting provider.
PORT=3000
HOST=0.0.0.0
# Set only for a known reverse-proxy topology: loopback or a trusted hop count.
TRUST_PROXY=1
NODE_ENV=production

DB_HOST=your-production-db-host
DB_PORT=3306
DB_NAME=odm_cmms
DB_USER=odm_cmms
DB_PASSWORD=replace-with-a-secret
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
SESSION_SECRET=replace-with-a-long-random-secret

UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=uploads
# CSV imports are separately constrained by Multer file size and this row cap
ASSET_IMPORT_MAX_ROWS=10000
REQUEST_BODY_LIMIT=1mb
# Comma-separated trusted browser origins. Leave blank when the app is same-origin only.
CORS_ALLOWED_ORIGINS=https://app.example.com
LOG_LEVEL=info
