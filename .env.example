# ================================================
# ODM-CMMS Environment Configuration
# ================================================

# Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=odm_cmms
DB_USER=root
DB_PASSWORD=your_password_here
DB_CONNECTION_LIMIT=10

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=uploads
# CSV imports are separately constrained by Multer file size and this row cap
ASSET_IMPORT_MAX_ROWS=10000


# Request/CORS Configuration
REQUEST_BODY_LIMIT=1mb
# Comma-separated browser origins allowed to send credentialed cross-origin requests
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set only when deployed behind a known proxy: loopback or a trusted hop count (for example 1)
TRUST_PROXY=
