# ================================================
# ODM-CMMS Environment Configuration
# ================================================

# Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Database Configuration
#
# Phase 3: PostgreSQL is the primary runtime database. The API/HTTP server
# connects to PostgreSQL via the `pg` driver. The legacy `mysql2` package
# remains installed ONLY for one-off import/migration utilities
# (e.g. src/utils/import-csv.js, src/utils/init-db.js) and is never loaded
# by the application runtime.
#
# Both libpq-style PG* variables and DB_* aliases are supported by the
# runtime adapter. The defaults below target a local PostgreSQL instance.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=odm_cmms
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_CONNECTION_LIMIT=10
# Set to "true" when connecting to a PostgreSQL server that requires TLS.
DB_SSL=false
# Set to "false" when using a self-signed certificate in development.
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional libpq-style variables (take precedence over DB_* when set)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=odm_cmms
# PGUSER=postgres
# PGPASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=uploads
# CSV imports are separately constrained by Multer file size and this row cap
ASSET_IMPORT_MAX_ROWS=10000


# Request/CORS Configuration
REQUEST_BODY_LIMIT=1mb
# Comma-separated browser origins allowed to send credentialed cross-origin requests
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set only when deployed behind a known proxy: loopback or a trusted hop count (for example 1)
TRUST_PROXY=
